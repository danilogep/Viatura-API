# Copie para .env e ajuste. Nenhum valor real de produção entra neste arquivo.

# --- Banco ---
POSTGRES_USER=viatura
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=viatura_db

# URL usada pela API. Dentro do docker-compose o host é o nome do serviço (db);
# rodando a API fora do compose, use 127.0.0.1.
DB_URL=postgresql+asyncpg://viatura:troque-esta-senha@db:5432/viatura_db

# --- API ---
# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ecoa o SQL no console. Mantenha false fora do desenvolvimento.
SQL_ECHO=false

# --- Frontend ---
# Caminho local do repositório do frontend, usado como build context do compose.
FRONTEND_PATH=../viatura-frontend
# URL que o navegador usa para falar com a API.
VITE_API_URL=http://localhost:8000
