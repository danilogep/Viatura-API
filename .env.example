# Configuração do Docker Compose. Copie para .env na raiz.
# Para rodar Python/React fora do Docker, use os exemplos de cada subpasta.

POSTGRES_USER=viatura
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=viatura_db

API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
SQL_ECHO=false

# Opcional: o Compose calcula estes valores a partir das portas acima.
# Descomente para acessar por um domínio ou endereço diferente de localhost.
# CORS_ORIGINS=https://seu-frontend.example
# VITE_API_URL=https://sua-api.example
# VITE_API_URL entra no build: após alterá-la, reconstrua o frontend.
