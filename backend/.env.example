# Desenvolvimento local, com os comandos executados dentro de backend/.
# O host 127.0.0.1 é o PostgreSQL acessível pela máquina do desenvolvedor.
# Se usar `docker compose up -d db`, mantenha usuário, senha, banco e porta
# iguais aos configurados no .env da raiz.
DB_URL=postgresql+asyncpg://viatura:troque-esta-senha@127.0.0.1:5432/viatura_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false
